<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <springProperty scope="context"
                    name="AGENT_AUDIT_LOG_DIR"
                    source="agent.audit.log-dir"
                    defaultValue="log"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="AGENT_AUDIT_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${AGENT_AUDIT_LOG_DIR}/agent-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${AGENT_AUDIT_LOG_DIR}/agent-audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} [%X{interactionId}] [%X{conversationId}] %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.jacolp.agent.audit" level="INFO" additivity="false">
        <appender-ref ref="AGENT_AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
